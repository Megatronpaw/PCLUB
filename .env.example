# Скопируй в .env и подставь свои значения.
# .env содержит локальные секреты и не попадает в Git.

POSTGRES_USER=pclub
POSTGRES_PASSWORD=смени_меня
POSTGRES_DB=pclub

# Ключ подписи: минимум 32 байта. Генерация: openssl rand -base64 48
JWT__SIGNINGKEY=смени_меня_на_случайную_строку_минимум_32_символа
JWT__ISSUER=pclub
JWT__AUDIENCE=pclub-api
